# ==========================================
# REYY PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. Supabase (Wajib - database analytics, pesan kontak, dan leads)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Server-only; required for the protected admin analytics route. Never prefix
# this variable with NEXT_PUBLIC_ and never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 2. Google Gemini AI (Wajib - untuk AI Portfolio Assistant)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"
# Opsional: default model
GEMINI_MODEL="gemini-2.0-flash"

# 3. Dashboard Admin (Wajib - password proteksi halaman /admin)
ADMIN_SECRET="your-secure-admin-password"

# 4. Canonical Site URL (Opsional - default: https://portoreyy.vercel.app)
NEXT_PUBLIC_SITE_URL="https://portoreyy.vercel.app"

# 5. Resend Email Notifications (Opsional - notifikasi email saat ada recruiter/lead masuk)
# RESEND_API_KEY="re_..."
# NOTIFICATION_EMAIL="reyyhadri@gmail.com"

# 6. Upstash Redis (Opsional - untuk rate limiting distributed di production)
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
# CHAT_RATE_LIMIT_SALT="random-secure-salt"
